{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "entry": [
    "supabase/functions/*/index.ts",
    "scripts/*.mjs",
    "sentry.*.config.ts",
    "src/**/*.test.{ts,tsx}"
  ],

  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "supabase/functions/**/*.ts"],

  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "shadcn",
    "playwright",
    "lint-staged"
  ],

  "ignoreExportsUsedInFile": true,

  "paths": {
    "@/*": ["src/*"]
  }
}
